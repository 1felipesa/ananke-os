# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables & secrets
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
service-account*.json
!service-account*.example.json

# Node & dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
dist/
build/
.next/
out/

# OS generated files
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/

# Testing & Coverage
coverage/
.nyc_output/
*.lcov

# Data Batch Runtime Outputs (preserve directories & examples)
data/incoming/*
!data/incoming/.gitkeep
!data/incoming/*.example
data/reports/*
!data/reports/.gitkeep
# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
*.egg-info/
.eggs/
*.egg

# Testing & Linting Caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
